// Build settings shared by every build of EyeCapture. Committed.
//
// Signing lives in Local.xcconfig next to this file, which git ignores, so
// your team and bundle identifier survive `ruby generate_project.rb` and
// `git pull`. Copy Local.xcconfig.example to Local.xcconfig and fill it in.
// Do not pick the team in Xcode's Signing & Capabilities tab: Xcode writes
// that into project.pbxproj, which is regenerated.

PRODUCT_BUNDLE_IDENTIFIER = org.forsee.EyeCapture
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Optional: missing in CI and on a fresh checkout.
#include? "Local.xcconfig"
