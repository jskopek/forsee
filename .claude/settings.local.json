      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pipx:*)",
      "Bash(uv:*)",
      "Bash(poetry:*)",
      "Bash(poetry run *:*)",
      "Bash(rye:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(mypy:*)",
      "Bash(coverage:*)",
      "Bash(uvicorn:*)",
      "Bash(django-admin:*)",
      "Bash(python manage.py:*)",
      "Bash(go:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(gcc:*)",
      "Bash(zig:*)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(gradle:*)",
      "Bash(mvn:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(kubectl:*)",
      "Bash(ssh:*)",
      "Bash(openssl:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:nodejs.org)",
      "Bash(mv:*)"
    ],
    "deny": [
      "FileSystem(*:.env)",
      "FileSystem(*:.env.*)",
      "FileSystem(read:.env)",
      "FileSystem(read:.env.*)",
      "FileSystem(write:.env)",
      "FileSystem(write:.env.*)",
      "FileSystem(delete:.env)",
      "FileSystem(delete:.env.*)",
      "FileSystem(*:/)",
      "FileSystem(*:../*)",
      "FileSystem(*:/home/*)",
      "FileSystem(*:/Users/*)",
      "FileSystem(*:/etc/*)",
      "FileSystem(*:/var/*)",
      "FileSystem(*:/Library/*)",
      "FileSystem(*:/System/*)",
      "FileSystem(*:C:\\\\*)",
      "FileSystem(*:D:\\\\*)"
    ],
    "ask": [
      "FileSystem(read:../*)",
      "FileSystem(write:../*)",
      "FileSystem(delete:../*)",
      "FileSystem(move:../*)",
      "FileSystem(mkdir:../*)"
    ]
  }
}